;test.c:6: int fib(int n) { return n < 2 ? n : fib(n-1) + fib(n-2); }
;	---------------------------------
; Function fib
; ---------------------------------
_fib::
	ex	de, hl
	ld	a, e
	sub	a, #0x02
	ld	a, d
	rla
	ccf
	rra
	sbc	a, #0x80
	ret	c
	ld	l, e
	ld	h, d
	dec	hl
	push	de
	call	_fib
	ex	de, hl
	pop	de
	dec	de
	dec	de
	ex	de, hl
	push	de
	call	_fib
	pop	hl
	add	hl, de
	ex	de, hl
	ret
;test.c:8: long mul(long a, long b) { return a * b; }
;	---------------------------------
; Function mul
; ---------------------------------
_mul::
	ld	iy, #2
	add	iy, sp
	ld	c, 2 (iy)
	ld	b, 3 (iy)
	push	bc
	ld	c, 0 (iy)
	ld	b, 1 (iy)
	push	bc
	call	__mullong
	pop	af
	pop	af
	ret
;test.c:10: void main(void) {
;	---------------------------------
; Function main
