_main::
	push	ix
	ld	ix,	#0
	add	ix, sp
	push	af
	dec	sp
;test.c:12: memset(buf, 0, sizeof(buf));
	ld	hl, #0x0010
	push	hl
	ld	de, #0x0000
	ld	hl, #_buf
	call	_memset
;test.c:13: for (i = 0; i < 16; i++) buf[i] = fib(i) + (unsigned char)mul(i, 3);
	ld	c, #0x00
00102$:
	ld	a, #<(_buf)
	add	a, c
	ld	-3 (ix), a
	ld	a, #>(_buf)
	adc	a, #0x00
	ld	-2 (ix), a
	ld	l, c
	ld	h, #0x00
	push	bc
	call	_fib
	pop	bc
	ld	-1 (ix), e
	ld	e, c
	xor	a, a
	ld	d, a
	ld	b, a
	push	bc
	ld	hl, #0x0000
	push	hl
	ld	l, #0x03
	push	hl
	ld	l, a
	ld	h, b
	call	_mul
	pop	af
	pop	af
	pop	bc
	ld	a, e
	add	a, -1 (ix)
	pop	hl
	push	hl
	ld	(hl), a
	inc	c
	ld	a, c
	sub	a, #0x10
	jr	c, 00102$
;test.c:14: }
	ld	sp, ix
	pop	ix
	ret
