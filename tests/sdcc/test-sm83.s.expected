;test.c:6: int fib(int n) { return n < 2 ? n : fib(n-1) + fib(n-2); }
;	---------------------------------
; Function fib
; ---------------------------------
_fib::
	ld	c, e
	ld	b, d
	ld	a, c
	sub	a, #0x02
	ld	a, b
	rla
	ccf
	rra
	sbc	a, #0x80
	ret	c
	ld	e, c
	ld	d, b
	dec	de
	push	bc
	call	_fib
	ld	l, c
	ld	h, b
	pop	bc
	dec	bc
	dec	bc
	push	hl
	ld	e, c
	ld	d, b
	call	_fib
	pop	hl
	add	hl, bc
	ld	c, l
	ld	b, h
	ret
;test.c:8: long mul(long a, long b) { return a * b; }
;	---------------------------------
; Function mul
; ---------------------------------
_mul::
	ldhl	sp,	#4
	ld	a, (hl+)
	ld	h, (hl)
	ld	l, a
	push	hl
	ldhl	sp,	#4
	ld	a, (hl+)
	ld	h, (hl)
	ld	l, a
	push	hl
	call	__mullong
	pop	hl
	add	sp, #4
	jp	(hl)
