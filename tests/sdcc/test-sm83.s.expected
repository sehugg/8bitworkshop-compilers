;test.c:13: for (i = 0; i < 16; i++) buf[i] = fib(i) + (unsigned char)mul(i, 3);
	ld	c, #0x00
00102$:
	ld	a, #<(_buf)
	add	a, c
	push	af
	ldhl	sp,	#2
	pop	af
	ld	(hl+), a
	ld	a, #>(_buf)
	adc	a, #0x00
	ld	(hl), a
	ld	e, c
	ld	d, #0x00
	push	bc
	call	_fib
	ld	e, c
	pop	bc
	ldhl	sp,	#2
	ld	(hl), e
	ld	e, c
	xor	a, a
	ld	d, a
	ld	b, a
	push	bc
	ld	hl, #0x0000
	push	hl
	ld	l, #0x03
	push	hl
	ld	c, e
	ld	e, a
	push	af
	ld	a, d
	ld	d, b
	ld	b, a
	pop	af
	call	_mul
	ld	l, c
	pop	bc
	ld	a, l
	ldhl	sp,	#2
	add	a, (hl)
	pop	hl
	push	hl
	ld	(hl), a
	inc	c
	ld	a, c
	sub	a, #0x10
	jr	c, 00102$
;test.c:14: }
	add	sp, #3
	ret
