; Functions definitions
	SEG CODE

	ORG $e800
	RORG $e800

main	SUBROUTINE
	LDX #0
	LDA #15
	STA dll,X
	INX
	LDA #33
	STA dll,X
	INX
	LDA #0
	STA dll,X
	INX
	LDA #8
	STA dll,X
	INX
	LDA #33
	STA dll,X
	INX
	LDA #0
	STA dll,X
	LDY #0
.for1
	INX
	LDA #7
	STA dll,X
	INX
	LDA dls+24,Y
	STA dll,X
	INX
	LDA dls,Y
	STA dll,X
.forupdate1
	INY
	CPY #24
	BNE .for1
.forend1
	INX
	LDA #15
	STA dll,X
	INX
	LDA #33
	STA dll,X
	INX
	LDA #0
	STA dll,X
	INX
	LDA #9
	STA dll,X
	INX
	LDA #33
	STA dll,X
	INX
	LDA #0
	STA dll,X
	LDA #>font
	STA CHARBASE
	LDA #>dll
	STA DPPH
	LDA #<dll
	STA DPPL
	LDA #24
	STA P0C1
	LDA #56
	STA P0C2
	LDA #88
	STA P0C3
	LDA #67
	STA CTRL
	LDX #23
	BMI .forend2
.for2
	LDA #0
	STA dlend,X
.forupdate2
	DEX
	BPL .for2
.forend2
	LDX #0
	LDA dls,X
	STA dlpnt
	LDA dls+24,X
	STA dlpnt+1
	LDY dlend,X
	LDA #<helloworld
	STA (dlpnt),Y
	INY
	LDA #96
	STA (dlpnt),Y
	INY
	LDA #>helloworld
	STA (dlpnt),Y
	INY
	LDA #20
	STA (dlpnt),Y
	INY
	LDA #0
	STA (dlpnt),Y
	INY
	STY dlend,X
	LDX #23
	BMI .forend3
.for3
	LDA dls,X
	STA dlpnt
	LDA dls+24,X
	STA dlpnt+1
	LDY dlend,X
	INY
	LDA #0
	STA (dlpnt),Y
.forupdate3
	DEX
	BPL .for3
.forend3
.dowhile1
.dowhile2
	LDA MSTAT
	AND #128
	BEQ .dowhile2
.dowhileend2
.dowhile3
	LDA MSTAT
	AND #128
	BNE .dowhile3
.dowhileend3
	JMP .dowhile1
.dowhileend1
	RTS

; Tables in ROM
dls
	.byte <dl0, <dl1, <dl2, <dl3, <dl4, <dl5, <dl6, <dl7
	.byte <dl8, <dl9, <dl10, <dl11, <dl12, <dl13, <dl14, <dl15
	.byte <dl16, <dl17, <dl18, <dl19, <dl20, <dl21, <dl22, <dl23
	.byte >dl0, >dl1, >dl2, >dl3, >dl4, >dl5, >dl6, >dl7
	.byte >dl8, >dl9, >dl10, >dl11, >dl12, >dl13, >dl14, >dl15
	.byte >dl16, >dl17, >dl18, >dl19, >dl20, >dl21, >dl22, >dl23
helloworld
	hex 08050c0c0f20170f120c042180

        ORG $ff1e
        RORG $ff1e

START
    sei                     ; Disable interrupts
    cld                     ; Clear decimal mode

;******** Atari recommended startup procedure

    lda     #$07
    sta     $01        ; Lock into 7800 mode
    lda     #$7F
    sta     $3C        ; Disable DMA
    lda     #$00            
    sta     $38 
    sta     $01
    ldx     #$FF       ; Reset stack pointer
    txs

;************** Clear zero page and hardware ******

    ldx     #$40
    lda     #$00
crloop1    
    sta     $00,x      ; Clear zero page
    sta	    $100,x		 ; Clear page 1
    inx
    bne     crloop1

;************* Clear RAM **************************

    ldy     #$00            ; Clear Ram
    lda     #$18            ; Start at $1800
    sta     $81             
    lda     #$00
    sta     $80
crloop3
    lda     #$00
    sta     ($80),y         ; Store data
    iny                     ; Next byte
    bne     crloop3         ; Branch if not done page
    inc     $81             ; Next page
    lda     $81
    cmp     #$20            ; End at $1FFF
    bne     crloop3         ; Branch if not

    ldy     #$00            ; Clear Ram
    lda     #$22            ; Start at $2200
    sta     $81             
    lda     #$00
    sta     $80
crloop4
    lda     #$00
    sta     ($80),y         ; Store data
    iny                     ; Next byte
    bne     crloop4         ; Branch if not done page
    inc     $81             ; Next page
    lda     $81
    cmp     #$27            ; End at $27FF
    bne     crloop4         ; Branch if not

    ldx     #$00
    lda     #$00
crloop5                     ; Clear 2100-213F
    sta     $2100,x
    inx
    cpx     #$40
    bne     crloop5
    jmp     main 

NMI
    RTI

IRQ
    RTI
                
        ORG $fff8
        .byte $FF ; Region verification
        .byte $F7 
        .word #NMI	; NMI
        .word #START	; RESET
        .word #IRQ	; IRQ
        
	END
